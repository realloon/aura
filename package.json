{
  "name": "@realloon/aura",
  "version": "0.5.1",
  "description": "A syntax-highlighting library for streaming output.",
  "license": "MIT",
  "keywords": [
    "highlight",
    "syntax-highlighter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/style.css dist/style.css",
    "prepack": "bun run build",
    "benchmark": "bun run benchmarks/csharp.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
